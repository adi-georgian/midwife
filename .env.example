# midWife — Environment Variables
# Copy this file to .env and fill in what you need. Nothing here is required for the
# app to *start* anymore; missing providers are simply skipped.

# ── Option A: public API keys (simplest for local development) ──────────────────
# Anthropic API key (primary LLM)        — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Google Gemini API key (fallback LLM)   — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Option B: GCP Vertex AI (internal/sensitive use — keeps data in Georgian's GCP) ──
# Set this to your GCP project id to route BOTH Claude and Gemini through Vertex AI.
# When set, the public API keys above are ignored.
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=us-east5            # region for Claude on Vertex
# GEMINI_VERTEX_REGION=us-central1    # region for Gemini on Vertex
# CLAUDE_MODEL=claude-sonnet-4-6      # may need an @version suffix on Vertex
# (Auth uses Application Default Credentials — e.g. `gcloud auth application-default login`.)

# ── Database ────────────────────────────────────────────────────────────────────
# Where canvases are stored. Defaults to a local SQLite file (backend/midwife.db).
# In production, point this at Cloud SQL / Render Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/midwife

# ── Local development identity (temporary, until real SSO login) ─────────────────
# DEV_USER_EMAIL=you@georgian.io
